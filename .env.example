# Supabase project credentials (Project Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for account deletion. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public site URL (used for OAuth redirects, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://dr-fraction.me

# Optional — only needed if you wire newsletter sending via Resend.
# Get a key at https://resend.com/api-keys (never commit a real key).
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM="Dr Fraction <newsletter@dr-fraction.me>"

# Create and publish these templates in Resend, then paste their IDs or aliases here.
RESEND_TEMPLATE_WELCOME=dr-fraction-welcome
RESEND_TEMPLATE_NEWSLETTER=dr-fraction-newsletter
RESEND_TEMPLATE_WEBINAR_ANNOUNCEMENT=dr-fraction-webinar-announcement
RESEND_TEMPLATE_WEBINAR_REMINDER=dr-fraction-webinar-reminder

# Signing secret of the Resend inbound webhook (Webhooks -> signing secret).
# Required for delivery/open/click tracking on /api/resend/webhook.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret-here

# Protects the webinar reminder cron (Vercel Cron sends this as a Bearer token).
# Generate one with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string
